# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SERVICE_NAME=financial-calculator-api
LOG_LEVEL=info

# Infrastructure Connections
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_calculator?schema=public
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Auth Configuration
JWT_ACCESS_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
